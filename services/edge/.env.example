CAMERA_SOURCE=0
CAMERA_KIND=avfoundation
CAMERA_LABEL=FaceTime HD Camera
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
PROCESS_FPS=10
DETECTOR_BACKEND=ultralytics
DETECTOR_MODEL=yolo11n-pose.pt
DETECTOR_DEVICE=cpu
DETECTOR_IMAGE_SIZE=512
PERSON_CONFIDENCE=0.45
PPE_PERSISTENCE_SECONDS=3
PPE_RECOVERY_SECONDS=5
IDENTITY_PERSISTENCE_SECONDS=3
PPE_KEYPOINT_CONFIDENCE=0.45
PPE_MINIMUM_BRIGHTNESS=55
PPE_MASK_COLOUR=blue
PPE_GLOVE_COLOUR=red
PPE_HAIRNET_COLOUR=blue
PPE_APRON_COLOUR=blue
PPE_MASK_COLOUR_RATIO=0.055
PPE_GLOVE_COLOUR_RATIO=0.045
PPE_HAIRNET_COLOUR_RATIO=0.055
PPE_APRON_COLOUR_RATIO=0.055
# Tomorrow's controlled acceptance uses mask and gloves. Enable these only
# when the matching controlled-colour demonstration PPE is available and calibrated.
PPE_REQUIRE_HAIRNET=false
PPE_REQUIRE_APRON=false
IDENTITY_BINDING_SECONDS=5
PROCESS_MARKER_DWELL_SECONDS=0.5
INVENTORY_LINE_POSITION=0.81
INVENTORY_LINE_HYSTERESIS=0.025
INVENTORY_MARKER_DWELL_SECONDS=0.3

# The demo source is always labelled Simulated. For a physical sensor, install
# the optional `sensors` dependency group and select serial or MQTT.
TEMPERATURE_SOURCE=simulated
TEMPERATURE_SENSOR_ID=TEMP-SIM-01
TEMPERATURE_LABEL=Cold Storage Demo
TEMPERATURE_INITIAL_C=4.2
TEMPERATURE_MIN_C=0
TEMPERATURE_MAX_C=5
TEMPERATURE_STALE_SECONDS=15
TEMPERATURE_SERIAL_PORT=
TEMPERATURE_SERIAL_BAUD=9600
TEMPERATURE_MQTT_HOST=
TEMPERATURE_MQTT_PORT=1883
TEMPERATURE_MQTT_TOPIC=orvia/sensors/temperature
TEMPERATURE_MQTT_USERNAME=
TEMPERATURE_MQTT_PASSWORD=
EDGE_HOST=127.0.0.1
EDGE_PORT=8787
EDGE_DEVICE_TOKEN=
SUPABASE_URL=
SUPABASE_INGEST_URL=
SUPABASE_EVIDENCE_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=foodsafe-kitchen-01
